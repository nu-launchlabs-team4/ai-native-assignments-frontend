{
  "name": "ai-native-assignments-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "api-types": "openapi-typescript openapi.json -o src/lib/api-schema.ts",
    "api-types:check": "openapi-typescript openapi.json -o src/lib/api-schema.ts --check",
    "api-types:pull": "node scripts/pull-openapi.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "mathlive": "^0.111.4",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "^31.0.1",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.5",
    "typescript": "^5",
    "vitest": "^5.1.1"
  }
}
